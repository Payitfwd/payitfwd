		"clsx": "^2.1.1",
		"codemirror": "^6.0.1",
		"dotenv": "^16.4.7",
		"drizzle-orm": "^0.41.0",
		"monaco-editor": "^0.49.0",
		"monaco-vim": "^0.4.1",
		"paneforge": "^0.0.5",
